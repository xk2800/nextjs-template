DATABASE_URL=
PORT=
NODE_ENV=development

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Per-project toggles (default true if unset) — turn a provider off without forking server/auth.ts
AUTH_ENABLE_GOOGLE=true
AUTH_ENABLE_EMAIL_PASSWORD=true

# One Tap is opt-in (default false). Needs both flags — one is read server-side,
# the other is inlined into the client bundle by Next.js at build time.
AUTH_ENABLE_ONE_TAP=false
NEXT_PUBLIC_AUTH_ENABLE_ONE_TAP=false

# Cookie-consent banner (default true). false = no banner, optional cookies treated as accepted.
# Only set false if none of your users are in the EU/UK (or another region with consent rules):
# fingerprinting without consent breaks GDPR/ePrivacy there. Admins can change it live in System Settings.
NEXT_PUBLIC_COOKIE_BANNER=true

BASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

RESEND_API_KEY=
# Full access key for marketing broadcasts (admin Marketing email page); falls back to RESEND_API_KEY
RESEND_BROADCAST_API_KEY=
# Resend segment users join from the dashboard "Email updates" toggle; blank hides it
RESEND_MARKETING_SEGMENT_ID=
# Sender for all email; must be on a domain verified in Resend
# EMAIL_FROM="My App <noreply@yourdomain.com>"

# Display name: 2FA issuer label + passkey relying-party name
APP_NAME=Next.js Template

# Dashboard feedback form — set either or both; neither hides the Feedback button
FEEDBACK_DISCORD_WEBHOOK_URL=
# Comma-separated; sent via Resend
FEEDBACK_EMAIL=
