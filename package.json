{
  "name": "@xk2800/nextjs-template",
  "version": "0.5.3",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/xk2800/nextjs-template.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": [
    "./dist/config/env.js",
    "./dist/config/env.mjs",
    "./dist/db/index.js",
    "./dist/db/index.mjs",
    "./dist/auth/index.js",
    "./dist/auth/index.mjs",
    "./dist/activity/logger.js",
    "./dist/activity/logger.mjs",
    "./dist/activity/queries.js",
    "./dist/activity/queries.mjs",
    "./dist/sessions/queries.js",
    "./dist/sessions/queries.mjs",
    "./dist/admin/queries.js",
    "./dist/admin/queries.mjs",
    "./dist/users/queries.js",
    "./dist/users/queries.mjs",
    "./dist/settings/queries.js",
    "./dist/settings/queries.mjs"
  ],
  "files": [
    "dist",
    "components/ui",
    "components/auth",
    "components/theme",
    "components/providers",
    "components/email",
    "components/dashboard",
    "lib/utils.ts",
