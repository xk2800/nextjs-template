  "scripts": {
    "dev": "bun --env-file=.env.development next dev --turbopack",
    "build": "npm run build:lib && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "bun lib/utils/__tests__/recalculate-columns.test.ts && bun lib/auth/__tests__/two-factor.test.ts && bun lib/auth/__tests__/auth-throttle-limits.test.ts && bun lib/security/__tests__/shared-devices.test.ts && bun lib/config/__tests__/maintenance.test.ts && bun lib/utils/__tests__/install-target.test.ts && bun lib/utils/__tests__/file-upload-accept.test.ts && bun lib/security/__tests__/cookie-names.test.ts && bun lib/email/__tests__/marketing-email.test.ts && bun scripts/bump-version.test.ts",
    "build:lib": "tsup",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "doctor": "bun --env-file=.env.development scripts/doctor.ts",
    "prepublishOnly": "bun run typecheck && bun run build:lib",
    "bump-version": "bun scripts/bump-version.ts",
    "generate": "bun drizzle-kit generate",
    "migrate:dev": "bun --env-file=.env.development drizzle-kit migrate",
    "migrate:prod": "bun --env-file=.env.production drizzle-kit migrate",
    "migrate:test": "bun --env-file=.env.test drizzle-kit migrate",
    "studio:dev": "bun --env-file=.env.development drizzle-kit studio",
    "studio:prod": "bun --env-file=.env.production drizzle-kit studio",
    "dev:doppler": "doppler run -- next dev --turbopack",
    "build:doppler": "doppler run -- next build",
    "start:doppler": "doppler run -- next start",
    "generate:doppler": "doppler run -- drizzle-kit generate",
    "migrate:doppler": "doppler run -- drizzle-kit migrate",
    "studio:doppler": "doppler run -- drizzle-kit studio",
    "docs:dev": "cd docs && bun run dev"
  },
