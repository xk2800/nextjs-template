  "exports": {
    "./package.json": "./package.json",
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.mjs",
      "require": "./dist/auth/index.js"
    },
    "./auth/helpers": {
      "types": "./dist/auth/helpers.d.ts",
      "import": "./dist/auth/helpers.mjs",
      "require": "./dist/auth/helpers.js"
    },
    "./auth-client": {
      "types": "./dist/auth-client/index.d.ts",
      "import": "./dist/auth-client/index.mjs",
      "require": "./dist/auth-client/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.mjs",
      "require": "./dist/db/index.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.mjs",
      "require": "./dist/db/schema.js"
    },
    "./config/env": {
      "types": "./dist/config/env.d.ts",
      "import": "./dist/config/env.mjs",
      "require": "./dist/config/env.js"
    },
    "./types/auth/loginSchema": {
      "types": "./dist/types/auth/loginSchema.d.ts",
      "import": "./dist/types/auth/loginSchema.mjs",
      "require": "./dist/types/auth/loginSchema.js"
    },
    "./types/auth/signupSchema": {
      "types": "./dist/types/auth/signupSchema.d.ts",
      "import": "./dist/types/auth/signupSchema.mjs",
      "require": "./dist/types/auth/signupSchema.js"
    },
    "./activity/logger": {
      "types": "./dist/activity/logger.d.ts",
      "import": "./dist/activity/logger.mjs",
      "require": "./dist/activity/logger.js"
    },
    "./activity/queries": {
      "types": "./dist/activity/queries.d.ts",
      "import": "./dist/activity/queries.mjs",
      "require": "./dist/activity/queries.js"
    },
    "./sessions/queries": {
      "types": "./dist/sessions/queries.d.ts",
      "import": "./dist/sessions/queries.mjs",
      "require": "./dist/sessions/queries.js"
    },
    "./admin/queries": {
      "types": "./dist/admin/queries.d.ts",
      "import": "./dist/admin/queries.mjs",
      "require": "./dist/admin/queries.js"
    },
    "./users/queries": {
      "types": "./dist/users/queries.d.ts",
      "import": "./dist/users/queries.mjs",
      "require": "./dist/users/queries.js"
    },
    "./settings/queries": {
      "types": "./dist/settings/queries.d.ts",
      "import": "./dist/settings/queries.mjs",
      "require": "./dist/settings/queries.js"
    },
    "./lib/utils": "./lib/utils.ts",
    "./lib/formatters": "./lib/formatters.ts",
    "./lib/recalculate-columns": "./lib/recalculate-columns.ts",
    "./lib/maintenance": "./lib/maintenance.ts",
    "./styles/theme.css": "./styles/theme.css",
    "./components/*": "./components/*.tsx"
  },
  "typesVersions": {
    "*": {
      "auth": [
        "dist/auth/index.d.ts"
      ],
      "auth/helpers": [
        "dist/auth/helpers.d.ts"
      ],
      "auth-client": [
        "dist/auth-client/index.d.ts"
      ],
      "db": [
        "dist/db/index.d.ts"
      ],
      "db/schema": [
        "dist/db/schema.d.ts"
      ],
      "config/env": [
        "dist/config/env.d.ts"
      ],
      "types/auth/loginSchema": [
        "dist/types/auth/loginSchema.d.ts"
      ],
      "types/auth/signupSchema": [
        "dist/types/auth/signupSchema.d.ts"
      ],
      "activity/logger": [
        "dist/activity/logger.d.ts"
      ],
      "activity/queries": [
        "dist/activity/queries.d.ts"
      ],
      "sessions/queries": [
        "dist/sessions/queries.d.ts"
      ],
      "admin/queries": [
        "dist/admin/queries.d.ts"
      ],
      "users/queries": [
        "dist/users/queries.d.ts"
      ],
      "settings/queries": [
        "dist/settings/queries.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run build:lib && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "bun lib/recalculate-columns.test.ts && bun lib/auth-throttle-limits.test.ts && bun lib/shared-devices.test.ts && bun lib/maintenance.test.ts",
    "build:lib": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "doctor": "bun --env-file=.env.development scripts/doctor.ts",
    "prepublishOnly": "bun run typecheck && bun run build:lib",
    "bump-version": "bun scripts/bump-version.ts",
    "generate": "bun drizzle-kit generate",
    "migrate:dev": "bun --env-file=.env.development drizzle-kit migrate",
    "migrate:prod": "bun --env-file=.env.production drizzle-kit migrate",
    "migrate:test": "bun --env-file=.env.test drizzle-kit migrate",
    "studio:dev": "bun --env-file=.env.development drizzle-kit studio",
    "studio:prod": "bun --env-file=.env.production drizzle-kit studio",
    "dev:doppler": "doppler run -- next dev --turbopack",
    "build:doppler": "doppler run -- next build",
    "start:doppler": "doppler run -- next start",
    "generate:doppler": "doppler run -- drizzle-kit generate",
    "migrate:doppler": "doppler run -- drizzle-kit migrate",
    "studio:doppler": "doppler run -- drizzle-kit studio",
    "docs:dev": "cd docs && bun run dev"
  },
