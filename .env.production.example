DATABASE_URL=
PORT=
NODE_ENV=production

# Better-Auth secret for signing cookies and tokens
AUTH_SECRET=

# Google OAuth credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL for auth callbacks (Better-Auth) - Replace with your production URL
BETTER_AUTH_URL=https://your-domain.com

# For client-side auth client - Replace with your production URL
NEXT_PUBLIC_APP_URL=https://your-domain.com
